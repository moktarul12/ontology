# ── Preferred for richer Overview / Timeline prose ──────────────
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Optional: force one provider (gemini | groq | openai)
# AI_PROVIDER=gemini

# ── Free alternate (fast) ───────────────────────────────────────
# Key: https://console.groq.com/keys
# Used when Gemini is unset or fails over
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# ── Paid optional ───────────────────────────────────────────────
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ── Response cache (AI timeline / enrich) ───────────────────────
# Always uses memory + disk. Redis when REDIS_URL is set (real server),
# or an embedded Redis stand-in for local if the server is down.
# REDIS_URL=redis://127.0.0.1:6379
# CACHE_DIR=.cache/ai
# CACHE_TTL_SECONDS=604800
# CACHE_DISABLED=1

# Endpoints: POST /api/ai/timeline | /enrich | /compare  |  GET /api/ai/status
